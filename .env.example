# ==== GLM (智谱) API ====
# 在 https://open.bigmodel.cn 控制台获取
ZHIPU_API_KEY=
# 模型名，可按需更换
GLM_MODEL=glm-5.3-flash
# 最终攻略合成用的更强模型（分段笔记/事实抽取用上面的 GLM_MODEL 省额度）
GLM_FINAL_MODEL=glm-5.3
# OpenAI 兼容接口地址，一般不用改
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ==== Bilibili ====
# SESSDATA Cookie（获取 AI 智能字幕需要登录态），也可以在前端设置里填写
BILIBILI_SESSDATA=

# ==== 本地语音识别（无可用字幕时的兜底）====
# 模型尺寸：tiny/base/small/medium/large-v3，需自备模型文件到 models/faster-whisper-<size>/
ASR_MODEL=medium

# ==== 服务 ====
HOST=127.0.0.1
PORT=8300
